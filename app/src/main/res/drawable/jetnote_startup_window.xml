        <shape android:shape="rectangle">
            <solid android:color="#AED194" />
        </shape>
    </item>
    <item android:gravity="center" android:width="112dp" android:height="112dp">
        <inset android:drawable="@drawable/icon" />
    </item>
</layer-list>
