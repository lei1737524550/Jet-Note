<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JetNote" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- MAINTENANCE: Android 12+ system splash uses the same Jet Note background as the Activity splash. -->
        <item name="android:windowSplashScreenBackground">#AED194</item>
        <!-- Android 12+ mandatory system splash is intentionally iconless. The branded rounded icon + app name are rendered once by MainActivity, avoiding a duplicate square-icon stage. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/jetnote_system_splash_transparent</item>
        <!-- MAINTENANCE: Keep the mandatory Android 12+ splash icon background transparent. -->
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <!-- MAINTENANCE: The icon is static, so do not request extra system splash animation time. -->
        <item name="android:windowSplashScreenAnimationDuration">0</item>

        <item name="android:windowBackground">@drawable/jetnote_startup_window</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#AED194</item>
        <item name="android:statusBarColor">#AED194</item>
        <item name="android:colorControlActivated">#14A89A</item>
        <item name="android:colorAccent">#14A89A</item>
        <item name="android:textCursorDrawable">@drawable/jetnote_text_cursor</item>
    </style>
</resources>
