  "debug_settings_expand_animation": {
    "speed_or_duration": "speed",
    "duration_ms": 900,
    "speed_px_per_second": 10,
    "comment": "Jet Note maximum-distance shared-duration model. Measure every Debug-only Settings card from the shared viewport-bottom edge to its final position. D_max = max(D_i); in speed mode T = D_max / V_ref; every card uses T and therefore V_i = D_i / T."
  },
